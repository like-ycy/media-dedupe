# 项目配置 —— tools/ 下所有脚本共用，是唯一需要按仓库改动的文件。
#
# 字段含义见 docs/packaging-contract.md §2。改这里之前先确认：
# 产物名、dist 目录名、组件目录名会同时变化，运行时路径解析（Go 侧）要跟着改。

# 包名前缀与 dist 目录名。归档名形如 <SLUG>_<ver>[_full]_<os>_<arch>.zip。
SLUG=media-dedupe

# 分发目录名与 macOS .app 名（wails.json 的 name）。解压后的顶层条目就是它。
PRODUCT=media-dedupe

# 可执行文件名（wails.json 的 outputfilename，不含 .exe）。
EXE=media-dedupe

# Go 模块路径，用于 -ldflags 注入版本（<GO_MODULE>/internal/version.Version）。
GO_MODULE=media-dedupe

# 1 = 模板 B（Go + Python），0 = 模板 A（纯 Go）。
HAS_PYTHON=0

# 以下三个仅模板 B 使用。
# Python 源码包名（python/src/<PY_PACKAGE>）。
PY_PACKAGE=
# PyInstaller 的 --name / onedir 产出目录名（python/build/pyi/dist/<PY_BUILD_NAME>）。
PY_BUILD_NAME=
# 上述 Python 产物在 tools/ 下的组件目录名，通常就是组件名。
PY_COMPONENT=

# 需要单独发布成组件包（<c>_<ver>_<os>_<arch>.zip）的组件，空格分隔。
# 产物来源：PY_COMPONENT 取 python 产物，其余取 third_party/<c>/<os>-<arch>/。
COMPONENTS=

# 只随整包分发、不单独发布的组件（同样来自 third_party/<c>/<os>-<arch>/）。
BUNDLED=
